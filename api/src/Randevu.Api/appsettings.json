{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/randevu.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Jwt": {
    "Issuer": "randevu-api",
    "Audience": "randevu-web",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenLifetimeDays": 14
  },
  "Cors": {
    "Origins": [
      "https://nurullahmencik.github.io",
      "http://localhost:5304",
      "http://127.0.0.1:5304",
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "AuthWindowSeconds": 60
  },
  "WebApp": {
    "Url": "https://nurullahmencik.github.io/randevu-sistemi/"
  },
  "Business": {
    "Name": "Atölye Kuaför & Bakım",
    "Branch": "Kadıköy",
    "TimeZone": "Europe/Istanbul",
    "SlotStepMinutes": 15,
    "BookingHorizonDays": 30
  },
  "Seed": {
    "Enabled": true,
    "SampleAppointments": true
  }
}
